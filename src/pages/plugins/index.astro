---
import Base from '../../layouts/Base.astro';
import { getCatalog } from '../../lib/catalog.ts';
import { PLUGINS } from '../../lib/site.ts';
import { withBase } from '../../lib/urls.ts';
const catalog = await getCatalog();
---
<Base title="Plugins | WebberZone Code Library" description="Browse code snippets by WebberZone plugin."><div class="container section"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/code-library/">Home</a><span aria-hidden="true">/</span><span>Plugins</span></nav><p class="eyebrow">Plugins</p><h1>Browse by plugin</h1><div class="grid">{PLUGINS.map((plugin)=>{const count=catalog.filter((snippet)=>snippet.data.plugins.includes(plugin.slug)).length;return <article class="card"><h2><a href={withBase(`/plugins/${plugin.slug}/`)}>{plugin.name}</a></h2><p>{plugin.description}</p><p class="count">{count} snippets</p><p><a class="btn secondary" href={plugin.url}>Plugin page</a></p></article>})}</div></div></Base>
