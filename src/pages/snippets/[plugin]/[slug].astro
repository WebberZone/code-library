---
import { Code } from 'astro:components';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Badges from '../../../components/Badges.astro';
import Toc from '../../../components/Toc.astro';
import { getCatalog } from '../../../lib/catalog.ts';
import { displayDate } from '../../../lib/dates.ts';
import { KINDS, pluginName } from '../../../lib/site.ts';
import { githubUrl, withBase } from '../../../lib/urls.ts';
export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.map((snippet) => ({ params: { plugin: snippet.data.primaryPlugin, slug: snippet.data.slug }, props: { snippet } }));
}
const { snippet } = Astro.props;
const { Content } = await render(snippet.entry);
const gated = snippet.data.review.status === 'needs-review';
---
<Base title={`${snippet.data.title} | WebberZone Code Library`} description={snippet.data.description}>
  <div class="container section">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={withBase('/')}>Home</a><span aria-hidden="true">/</span><a href={withBase(`/plugins/${snippet.data.primaryPlugin}/`)}>{pluginName(snippet.data.primaryPlugin)}</a><span aria-hidden="true">/</span><span>{snippet.data.title}</span></nav>
    <div class="meta"><Badges item={snippet} />{snippet.data.tags.map((tag)=><span class="badge">{tag}</span>)}</div>
    <h1>{snippet.data.title}</h1><p class="lead">{snippet.data.description}</p>
    {gated ? <div class="notice" role="note"><strong>Needs review before use.</strong><ul>{snippet.data.review.reasons.map((reason)=><li>{reason}</li>)}</ul><p>Copy controls and downloads are disabled for this entry. You can inspect the source below and in GitHub.</p></div> : <div class="notice neutral" role="note"><strong>Compatibility note.</strong> This community example has not been verified against current WordPress, PHP or plugin releases. Test it on a staging site before production use.</div>}
    <div class="doc">
      <article class="article">
        <section class="markdown-body"><Content /></section>
        <h2>Requirements</h2><ul class="requirement-list">{snippet.data.plugins.map((plugin)=><li><a href={withBase(`/plugins/${plugin}/`)}>{pluginName(plugin)}</a></li>)}{snippet.data.requiresPro && <li>The corresponding Pro plugin must be installed and active.</li>}{snippet.data.requirements.map((requirement)=><li>{requirement}</li>)}</ul>
        <h2>Source</h2>
        <div class="source-shell" data-code><div class="source-head"><code>{snippet.data.source}</code><div class="source-actions">{!gated && <button type="button" data-copy>Copy PHP</button>}{snippet.sourceUrl && <a href={snippet.sourceUrl} download={snippet.filename}>Download PHP</a>}{snippet.zipUrl && <a href={snippet.zipUrl} download>Download plugin ZIP</a>}<a href={githubUrl(snippet.data.source)}>View on GitHub</a></div></div><Code code={snippet.code} lang="php" theme="github-dark" /></div>
        <h2>Details</h2><dl class="detail-list"><dt>Type</dt><dd>{KINDS[snippet.data.kind]}</dd>{gated && <><dt>Review</dt><dd>Needs review</dd></>}{snippet.updated && <><dt>Last updated</dt><dd><time datetime={snippet.updated}>{displayDate(snippet.updated)}</time></dd></>}<dt>GitHub</dt><dd><a href={githubUrl(snippet.data.source)}>Source</a> · <a href={githubUrl(snippet.contentPath, 'edit')}>Edit companion</a> · <a href={githubUrl(snippet.data.source, 'commits')}>History</a></dd></dl>
        {snippet.data.references.length > 0 && <><h2>Developer references</h2><ul class="refs">{snippet.data.references.map((reference)=><li><a href={reference.url}>{reference.label}</a></li>)}</ul></>}
      </article>
      <Toc />
    </div>
  </div>
</Base>
<script>
  document.querySelectorAll('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const source = button.closest('[data-code]')?.querySelector('pre code')?.textContent ?? '';
      await navigator.clipboard.writeText(source);
      button.textContent = 'Copied';
      setTimeout(() => { button.textContent = 'Copy PHP'; }, 1600);
    });
  });
</script>
