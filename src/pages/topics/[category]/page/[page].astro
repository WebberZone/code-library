---
import Base from '../../../../layouts/Base.astro';
import SnippetBrowser from '../../../../components/SnippetBrowser.astro';
import { getCatalog, searchRecord } from '../../../../lib/catalog.ts';
import { paginate } from '../../../../lib/search.ts';
import { CATEGORIES, categoryName } from '../../../../lib/site.ts';
export async function getStaticPaths() {
  const catalog = await getCatalog();
  return CATEGORIES.flatMap((category) => {
    const snippets = catalog.filter((snippet) => snippet.data.category === category.slug);
    const pages = Math.ceil(snippets.length / 24);
    return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => ({ params: { category: category.slug, page: String(index + 2) }, props: { snippets } }));
  });
}
const snippets = Astro.props.snippets;
const category = Astro.params.category!;
const page = paginate(snippets, Number(Astro.params.page));
---
<Base title={`${categoryName(category)} snippets page ${page.page} | WebberZone Code Library`} description={`Search ${categoryName(category).toLowerCase()} snippets for WebberZone plugins.`}><div class="container section"><h1>{categoryName(category)} snippets</h1><SnippetBrowser records={snippets.map(searchRecord)} snippets={page.items} page={page.page} pages={page.pages} path={`/topics/${category}`} fixedCategory={category} /></div></Base>
